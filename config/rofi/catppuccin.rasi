* {
    bg: #1e1e2e;
    fg: #cdd6f4;
    accent: #89b4fa;
    surface: #313244;
    background-color: transparent;
    text-color: @fg;
}
window { background-color: @bg; border: 2px; border-color: @accent; width: 40%; padding: 12px; }
inputbar { background-color: @surface; padding: 8px; }
listview { lines: 8; margin: 8px 0 0 0; }
element { padding: 6px; }
element selected.normal { background-color: @accent; text-color: @bg; }
